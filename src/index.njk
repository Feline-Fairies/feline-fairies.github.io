---
layout: layouts/base.njk
seoTitle: Feline Fairies | Cat Rescue in St. Augustine, FL
title: Cat Rescue in St. Augustine, FL
description: Meet Feline Fairies, a foster-based nonprofit cat rescue in St. Augustine, Florida. Browse adoptable cats, foster, volunteer, or support basic care.
pageStyles:
  - /assets/css/homepage.css
---


<!-- ========================================
     HERO
======================================== -->

<section
  class="hero"
  aria-labelledby="hero-title"
>

  <div class="shell hero-grid">

    <div class="hero-copy">

      <p class="eyebrow">
        {{ home.hero.eyebrow }}
      </p>

      <h1 id="hero-title">

        <span class="hero-title-line">
          {{ home.hero.title.line1Before }}
          <em>{{ home.hero.title.accent }}</em>
        </span>

        <span class="hero-title-line">
          {{ home.hero.title.line2 }}
        </span>

        <span class="hero-title-line">
          {{ home.hero.title.line3 }}
        </span>

      </h1>

      <p class="hero-lede">
        {{ home.hero.text }}
      </p>

      <div class="hero-actions">

        <a
          class="button"
          href="{{ home.hero.primaryButton.url }}"
        >
          {{ home.hero.primaryButton.label }}
        </a>

        <a
          class="button button--outline"
          href="{{ home.hero.secondaryButton.url }}"
        >
          {{ home.hero.secondaryButton.label }}
        </a>

      </div>

    </div>


    <div class="hero-photo">

      <img
        src="{{ home.hero.image.src }}"
        srcset="
          {{ home.hero.image.src640 }} 640w,
          {{ home.hero.image.src960 }} 960w,
          {{ home.hero.image.src }} 1024w
        "
        sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1150px) 46vw, 48vw"
        alt="{{ home.hero.image.alt }}"
        width="{{ home.hero.image.width }}"
        height="{{ home.hero.image.height }}"
        decoding="async"
        loading="eager"
        fetchpriority="high"
      >

      <div class="photo-note">

        <strong>
          {{ home.hero.badge.number }}
        </strong>

        <span>
          {{ home.hero.badge.label }}
        </span>

      </div>

    </div>

  </div>

</section>



<!-- ========================================
     INTRO
======================================== -->

<section
  class="intro"
  aria-labelledby="intro-title"
>

  <div class="shell intro-grid">

    <div>

      <p class="eyebrow">
        {{ home.intro.eyebrow }}
      </p>

      <h2 id="intro-title">
        {{ home.intro.titleBefore }}
        <em>{{ home.intro.titleAccent }}</em>
      </h2>

    </div>


    <p class="intro-copy">

      {{ home.intro.text }}

      <a href="{{ home.intro.linkUrl }}">
        {{ home.intro.linkLabel }}
      </a>.

    </p>

  </div>

</section>



<!-- ========================================
     MISSION
======================================== -->

<section
  class="mission"
  aria-labelledby="mission-title"
>

  <div class="shell mission-grid">

    <div class="mission-image-wrap">

      <img
        src="{{ home.mission.image.src }}"
        srcset="
          {{ home.mission.image.src640 }} 640w,
          {{ home.mission.image.src960 }} 960w,
          {{ home.mission.image.src }} 1086w
        "
        sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1150px) 440px, 46vw"
        alt="{{ home.mission.image.alt }}"
        width="{{ home.mission.image.width }}"
        height="{{ home.mission.image.height }}"
        loading="lazy"
        decoding="async"
      >

    </div>


    <div>

      <p class="eyebrow">
        {{ home.mission.eyebrow }}
      </p>

      <h2 id="mission-title">
        {{ home.mission.title }}
      </h2>

      {% for paragraph in home.mission.paragraphs %}

        <p>
          {{ paragraph }}
        </p>

      {% endfor %}

      <a
        class="button button--night"
        href="{{ home.mission.button.url }}"
      >
        {{ home.mission.button.label }}
      </a>

    </div>

  </div>

</section>



<!-- ========================================
     IMPACT
======================================== -->

<section
  class="impact"
  aria-labelledby="impact-title"
>

  <div class="shell impact-grid">

    <h2 id="impact-title">

      {{ home.impact.titleBefore }}

      <em>
        {{ home.impact.titleAccent }}
      </em>

    </h2>


    {% for item in home.impact.items %}

      <div class="impact-item">

        <strong
          class="impact-number"
          data-impact-number="{{ item.number }}"
        >
          {{ item.number }}
        </strong>

        <span>
          {{ item.label }}
        </span>

      </div>

    {% endfor %}

  </div>

</section>



<!-- ========================================
     WAYS TO HELP
======================================== -->

<section
  class="paths"
  id="get-involved"
  aria-labelledby="paths-title"
>

  <div class="shell">

    <div class="paths-heading">

      <div>

        <p class="eyebrow">
          {{ home.paths.eyebrow }}
        </p>

        <h2 id="paths-title">
          {{ home.paths.title }}
        </h2>

      </div>

      <p>
        {{ home.paths.text }}
      </p>

    </div>


    <div class="path-grid">

      {% for item in home.paths.items %}

        <article class="path-card">

          <span
            class="path-icon"
            aria-hidden="true"
          >
            {{ item.number }}
          </span>

          <h3>
            {{ item.title }}
          </h3>

          <p>
            {{ item.text }}
          </p>

          <a
            class="text-link"
            href="{{ item.url }}"
          >
            {{ item.linkLabel }}
          </a>

        </article>

      {% endfor %}

    </div>

  </div>

</section>



<!-- ========================================
     ADOPTION STEPS
======================================== -->

<section
  class="steps"
  aria-labelledby="steps-title"
>

  <div class="shell">

    <div class="steps-top">

      <div>

        <p class="eyebrow">
          {{ home.steps.eyebrow }}
        </p>

        <h2 id="steps-title">
          {{ home.steps.title }}
        </h2>

      </div>

      <p>
        {{ home.steps.text }}
      </p>

    </div>


    <div class="step-grid">

      {% for item in home.steps.items %}

        <div class="step">

          <span class="step-number">
            {{ item.number }}
          </span>

          <h3>
            {{ item.title }}
          </h3>

          <p>
            {{ item.text }}
          </p>

        </div>

      {% endfor %}

    </div>


    <a
      class="button"
      href="{{ home.steps.button.url }}"
    >
      {{ home.steps.button.label }}
    </a>

  </div>

</section>



<!-- ========================================
     DONATION CTA
======================================== -->

<section
  class="donation"
  aria-labelledby="donation-title"
>

  <div class="shell donation-inner">

    <div>

      <p class="eyebrow">
        {{ home.donation.eyebrow }}
      </p>

      <h2 id="donation-title">
        {{ home.donation.title }}
      </h2>

      <p>
        {{ home.donation.text }}
      </p>

      <a
        class="button button--night"
        href="{{ home.donation.button.url }}"
      >
        {{ home.donation.button.label }}
      </a>

    </div>

  </div>

</section>