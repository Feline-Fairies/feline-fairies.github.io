<footer class="site-footer">

  <div class="shell">

    <div class="footer-top">

      <div class="footer-brand-block">

        <a
          class="brand footer-brand"
          href="/"
          aria-label="Feline Fairies home"
        >

          <img
            src="/assets/images/feline-fairies-logo-web.webp"
            alt=""
            width="320"
            height="216"
            decoding="async"
            loading="lazy"
          >

          <span class="wordmark">

            Feline Fairies

            <span>
              {{ site.tagline }}
            </span>

          </span>

        </a>


        <nav
          class="footer-social"
          aria-label="Official social profiles"
        >

          <a
            href="{{ site.social.facebook.url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ site.social.facebook.label }} (opens in a new tab)"
          >

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
              fill="currentColor"
            >

              <path
                d="M13.5 21v-8h2.8l.4-3h-3.2V8.1c0-.9.3-1.6 1.6-1.6h1.7V3.8c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1V10H7.7v3h2.7v8h3.1Z"
              ></path>

            </svg>

          </a>


          <a
            href="{{ site.social.instagram.url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ site.social.instagram.label }} (opens in a new tab)"
          >

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            >

              <rect
                x="3.5"
                y="3.5"
                width="17"
                height="17"
                rx="5"
              ></rect>

              <circle
                cx="12"
                cy="12"
                r="4"
              ></circle>

              <circle
                cx="17.3"
                cy="6.7"
                r=".9"
                fill="currentColor"
                stroke="none"
              ></circle>

            </svg>

          </a>

        </nav>

      </div>


      <nav
        class="footer-nav"
        aria-label="Footer navigation"
      >

        {% for item in site.footerNavigation %}

          <a
            href="{{ item.url }}"
            {% if page.url == item.url %}
              aria-current="page"
            {% endif %}
          >
            {{ item.label }}
          </a>

        {% endfor %}

      </nav>

    </div>


    <div class="footer-bottom">

      <span>
        {{ site.name }} is a {{ site.nonprofitStatus }} nonprofit organization.
        EIN: {{ site.ein }}
      </span>

      <span>
        &copy; {{ currentYear }} {{ site.name }} · {{ site.location }}
      </span>

    </div>

  </div>

</footer>